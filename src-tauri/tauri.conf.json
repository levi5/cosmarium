{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cosmarium",
  "version": "0.1.0",
  "identifier": "com.cosmarium.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cosmarium",
        "width": 1180,
        "height": 760,
        "minWidth": 780,
        "minHeight": 560,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": false,
        "visible": false
      }
    ],
    "security": { "csp": null, "assetProtocol": { "enable": true, "scope": ["**"] } }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
